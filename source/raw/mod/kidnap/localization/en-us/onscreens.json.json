            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Priority Target: Palmer",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "kidnap_laptop_email_title"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Malakai \u0022Crackjaw\u0022 Vex",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "kidnap_laptop_email_from"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Command Unit 7C",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "kidnap_laptop_email_to"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
              "femaleVariant": "Palmer is just the bait. The real prize is V. Don\u0027t fuck this up.\\n\\nKeep the nomad breathing\u2014she\u0027s leverage, not meat for the grinder. Transfer her to the hideout as planned. I want every corner of that place locked down tight. No slip-ups, no loose ends.\\n\\nWhen V takes the bait, make sure the ambush rips \u0027em to shreds. A trap\u0027s only as good as its teeth\u2014make sure ours bite deep.\\n\\nNo excuses.\\n\\n- Vex",
              "maleVariant": "",
              "primaryKey": "0",
              "secondaryKey": "kidnap_laptop_email_text"
            },
            {
              "$type": "localizationPersistenceOnScreenEntry",
